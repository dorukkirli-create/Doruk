# Gercek personel ve fatura verisi asla repoya girmez
ornek_veri/
# Ayni ad bir sembolik bag olarak da olusabilir (calisma agaci kopyalari).
ornek_veri
cikti/
*.pkl
*.onbellek.pkl

# Calisma aninda uretilen defterler kisisel veri icerir
# (TC kimlik, ad soyad, sicil). Sadece masraf merkezi haritasi
# bir yapilandirma dosyasidir ve repoda tutulur.
veri/*.csv
!veri/masraf_merkezi_haritasi.csv
# Defter yedekleri (veri/gecmis/) ve gecici yazma dosyalari da TC tasir.
veri/gecmis/
veri/**/*.csv
veri/*.tmp
veri/**/*.tmp
*.csv.tmp
!veri/masraf_merkezi_haritasi.csv

__pycache__/
*.pyc
.venv/
venv/
.streamlit/secrets.toml
